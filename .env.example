# Copy to .env and `set -a && . ./.env && set +a` before `cargo run`.
# Everything here maps onto config/default.toml as GUM_<SECTION>__<KEY>.

DATABASE_URL=postgres://gum:gum@127.0.0.1:54340/gum_server
PORT=8080
GUM_PROFILE=local
RUST_LOG=info,sqlx=warn
GUM_LOG_FORMAT=pretty

# Where gum-indexer / gum-engine call back to (private network in production).
GUM_SERVER__CALLBACK_BASE_URL=http://127.0.0.1:8080

# gum-contracts generation (LocalBootstrap.s.sol fixtures for Anvil).
GUM_PAYMENTS__FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
GUM_PAYMENTS__RECOVERY_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Privy (docs.privy.io → app settings → verification key, PEM).
GUM_PRIVY__APP_ID=
GUM_PRIVY__VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# gum-indexer: base URL, one of its GUM_API__KEYS, and its GUM_WEBHOOK__SECRET.
GUM_INDEXER__BASE_URL=http://127.0.0.1:8081
GUM_INDEXER__WEBHOOK_SECRET=

# gum-engine: base URL (private network; no auth) and its webhook.signing_secret.
GUM_ENGINE__BASE_URL=http://127.0.0.1:8082
GUM_ENGINE__WEBHOOK_SECRET=

# A chain that ships disabled (Arc) is turned on with the line below, once the prerequisites in
# config/default.toml (chains section) hold:
# GUM_CHAINS__ARC__ENABLED=true

# Relay (dashboard.relay.link): lets payers pay with any token on any chain. Empty turns that off.
RELAY_API_KEY=

# Operator token for /v1/admin routes (empty disables them).
GUM_ADMIN__TOKEN=

# Tests create throwaway databases on this server.
TEST_DATABASE_URL=postgres://gum:gum@127.0.0.1:54340/gum_server
